# reflbo-nm-epd-420 defaults. Edit here, not in sdkconfig; personal overrides go in sdkconfig.defaults.local.
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB QIO (ESP32-S3R8 / ESP32-S3-WROOM-1-N16R8)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM; skip boot-time memory test for faster boot
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
# Large static scratch buffers (EXT_RAM_BSS_ATTR) go to PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# FreeRTOS 1000 Hz tick: ensures pdMS_TO_TICKS(<10) does NOT round to 0
CONFIG_FREERTOS_HZ=1000

# Console and logs on the USB-Serial-JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Core dumps go to the coredump partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=n
CONFIG_ESP_COREDUMP_LOGS=n

# `tasks` console command
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# Faster deep-sleep wakes: skip image validation, quiet bootloader
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# OTA with rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Web configurator
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_LWIP_MAX_SOCKETS=16

# TLS: mbedTLS buffers from PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
